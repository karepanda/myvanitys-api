classDiagram
    %% Product infrastructure: primary adapter, secondary adapters, persistence, mappers, exceptions.

    %% --- Primary adapter ---
    class ProductController {
        <<primaryAdapter>>
        +createProduct(...) ResponseEntity~ProductResponse~
        +findProductsByUserId(...) ResponseEntity~List~ProductResponse~~
        +searchProducts(...) ResponseEntity~ProductSearchResponse~
        +addReviewToProduct(...) ResponseEntity~ProductResponse~
        +addProductToUserVanity(...) ResponseEntity~ProductResponse~
        +getAllProductsWithCollectionStatus(...) ResponseEntity~List~ProductResponse~~
        +deleteProductByUser(...) ResponseEntity~Void~
    }
    class ProductResponseMapper {
        <<mapper>>
        +toResponseList(products: List~Product~) List~ProductResponse~
        +toReviewResponseList(reviews: List~Review~) List~ReviewResponse~
    }

    %% --- Persistence entities ---
    class ProductEntity {
        <<entity>>
        -productId: UUID
        -categoryId: UUID
        -version: Long
        -name: String
        -brand: String
        -colorHex: String
        -createdAt: Instant
        -updatedAt: Instant
    }

    class CategoryEntity {
        <<entity>>
        -categoryId: UUID
        -version: Long
        -name: String
        -createdAt: Instant
        -updatedAt: Instant
    }

    class ProductUserEntity {
        <<entity>>
        -productUserId: UUID
        -version: Long
        -userId: UUID
        -productId: UUID
        -reviews: List~ReviewEntity~
        -deletedAt: Instant
        -createdAt: Instant
        -updatedAt: Instant
    }

    class ReviewEntity {
        <<entity>>
        -reviewId: UUID
        -version: Long
        -rating: int
        -comment: String
        -productUserId: UUID
        -createdAt: Instant
        -updatedAt: Instant
        -deletedAt: Instant
    }

    %% --- Spring Data JPA repositories ---
    class JpaProductRepository {
        <<repository>>
        +findByUserId(userId: UUID) List~ProductEntity~
        +findByName(name: String) Optional~ProductEntity~
        +findByBrand(brand: String) Optional~ProductEntity~
        +findByCategoryId(categoryId: UUID) List~ProductEntity~
        +searchByNameOrBrand(term: String) List~ProductEntity~
        +findReviewsByProductId(productId: UUID) List~ReviewEntity~
        +findReviewsByProductIdAndUserId(productId: UUID, userId: UUID) List~ReviewEntity~
    }
    class JpaCategoryRepository {
        <<repository>>
        +findByName(name: String) Optional~CategoryEntity~
    }
    class JpaProductUserRepository {
        <<repository>>
        +findByProductId(productId: UUID) List~ProductUserEntity~
        +findByUserId(userId: UUID) List~ProductUserEntity~
        +findByProductIdAndUserId(productId: UUID, userId: UUID) Optional~ProductUserEntity~
    }
    class JpaReviewRepository {
        <<repository>>
        +findByProductUserId(productUserId: UUID) List~ReviewEntity~
    }

    %% --- Secondary adapters (implement domain ports) ---
    class ProductRepositoryAdapter {
        <<secondaryAdapter>>
        -categoryRepository: CategoryRepository
        -productUserRepository: ProductUserRepository
        -reviewRepository: ReviewRepository
        -jpaProductRepository: JpaProductRepository
        -productMapper: ProductMapper
        -categoryMapper: CategoryMapper
        -productUserRelationMapper: ProductUserRelationMapper
        -reviewMapper: ReviewMapper
    }
    class CategoryRepositoryAdapter {
        <<secondaryAdapter>>
    }
    class ReviewRepositoryAdapter {
        <<secondaryAdapter>>
    }
    class ProductUserRepositoryAdapter {
        <<secondaryAdapter>>
    }

    %% --- Mappers ---
    class ProductMapper {
        <<mapper>>
        +toDomain(...) Product
    }
    class CategoryMapper {
        <<mapper>>
        +toDomain(entity: CategoryEntity) Category
        +toEntity(category: Category) CategoryEntity
    }
    class ReviewMapper {
        <<mapper>>
    }
    class ReviewEntityMapper {
        <<mapper>>
    }
    class ProductUserRelationMapper {
        <<mapper>>
    }
    class EntityIdMapper {
        <<mapper>>
        +toEntityId(value: UUID) EntityId
        +toUuid(id: EntityId) UUID
    }

    %% --- Exceptions ---
    class DatabaseException {
        <<exception>>
    }
    class RepositoryResourceNotFoundException {
        <<exception>>
    }

    %% --- Relationships ---
    ProductController ..> ProductResponseMapper : uses

    ProductRepositoryAdapter ..|> ProductRepository : implements
    CategoryRepositoryAdapter ..|> CategoryRepository : implements
    ReviewRepositoryAdapter ..|> ReviewRepository : implements
    ProductUserRepositoryAdapter ..|> ProductUserRepository : implements

    ProductRepositoryAdapter --> JpaProductRepository : uses
    ProductRepositoryAdapter --> ProductMapper : uses
    ProductRepositoryAdapter --> CategoryMapper : uses
    ProductRepositoryAdapter --> ReviewMapper : uses
    ProductRepositoryAdapter --> ProductUserRelationMapper : uses
    CategoryRepositoryAdapter --> JpaCategoryRepository : uses
    CategoryRepositoryAdapter --> CategoryMapper : uses
    ReviewRepositoryAdapter --> JpaReviewRepository : uses
    ReviewRepositoryAdapter --> ReviewMapper : uses
    ProductUserRepositoryAdapter --> JpaProductUserRepository : uses

    JpaProductRepository --> ProductEntity : manages
    JpaCategoryRepository --> CategoryEntity : manages
    JpaProductUserRepository --> ProductUserEntity : manages
    JpaReviewRepository --> ReviewEntity : manages

    ProductUserEntity "1" --> "0..*" ReviewEntity : reviews
    ProductEntity "1" --> "1" CategoryEntity : category
    ProductUserEntity "1" --> "1" ProductEntity : product
