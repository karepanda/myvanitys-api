# syntax=docker/dockerfile:1
# Dockerfile for Production
# Multi-stage build to optimize size and security

# Stage 1: Build stage
FROM maven:3.9.11-eclipse-temurin-25-alpine AS builder
WORKDIR /app

# Copy pom.xml first to leverage Maven's cache
COPY pom.xml .
COPY .mvn .mvn

# Download dependencies using GitHub Packages credentials supplied as BuildKit secrets
RUN --mount=type=secret,id=github_username,required=true \
    --mount=type=secret,id=github_token,required=true \
    GITHUB_USERNAME="$(cat /run/secrets/github_username)" \
    GITHUB_TOKEN="$(cat /run/secrets/github_token)" \
    mvn -B -ntp dependency:go-offline -s .mvn/settings.xml

# Copy source code and compile
COPY src src
RUN --mount=type=secret,id=github_username,required=true \
    --mount=type=secret,id=github_token,required=true \
    GITHUB_USERNAME="$(cat /run/secrets/github_username)" \
    GITHUB_TOKEN="$(cat /run/secrets/github_token)" \
    mvn -B -ntp package -DskipTests -s .mvn/settings.xml

# Stage 2: Runtime stage
FROM eclipse-temurin:25-jre-alpine
WORKDIR /app

# Create a non-privileged user to run the application
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

# Copy the compiled JAR from the previous stage
COPY --from=builder /app/target/*.jar app.jar

# Define environment variables
ENV SPRING_PROFILES_ACTIVE=prod
ENV JAVA_OPTS="-Xms512m -Xmx1g -XX:+UseG1GC"

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
